# Copy to deploy/.env and set unique credentials. Never commit .env.
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-root-password
BOOTSTRAP_USER=club-admin
BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# Set true when serving through HTTPS.
COOKIE_SECURE=false
